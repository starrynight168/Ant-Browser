{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "Ant Browser",
  "outputfilename": "ant-chrome",
  "frontend:dir": "frontend_flutter",
  "frontend:install": "flutter pub get",
  "frontend:build": "flutter build web --release --base-href / --output build/web",
  "frontend:dev:build": "flutter build web --debug --base-href / --output build/web",
  "author": {
    "name": "Ant Chrome Team",
    "email": "contact@antblack.de"
  },
  "info": {
    "companyName": "Ant Chrome",
    "productName": "Ant Browser",
    "productVersion": "1.9.4",
    "copyright": "Copyright © 2026",
    "comments": "面向多账号隔离、代理绑定和本地环境管理的桌面浏览器工具"
  },
  "nsisType": "multiple",
  "obfuscated": false,
  "wailsjsdir": "./frontend_flutter/web/wailsjs"
}
